<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>FORGE POWER LAND</title>
<style>
  :root{
    --bg1:#0c1220; --bg2:#050810;
    --panel:#121a2c; --panel2:#1a2540;
    --ink:#eaf1ff; --muted:#7b8aa8;
    --gold:#fbbf24; --green:#4ade80; --red:#f87171; --blue:#38bdf8; --purple:#c084fc;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none;}
  html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#000;
    font-family:'Segoe UI',system-ui,-apple-system,sans-serif;color:var(--ink);touch-action:none;}
  #stage{position:relative;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;
    background:radial-gradient(ellipse at 50% 0%,#182238 0%,#04060c 75%);}
  #frame{position:relative;width:min(520px,100vw);height:min(100vh,960px);display:flex;flex-direction:column;}

  .hud{display:flex;justify-content:space-between;align-items:flex-start;padding:8px 10px;
    background:linear-gradient(180deg,var(--panel),transparent);z-index:6;flex-shrink:0;gap:6px;}
  .hud-col{display:flex;flex-direction:column;gap:2px;}
  .stat{display:flex;align-items:center;gap:4px;font-size:12px;font-weight:700;}
  .stat .ic{font-size:13px;}
  .cash{color:var(--gold);}
  .pop{color:var(--blue);}
  .edu{color:var(--purple);}
  .income{color:var(--green); font-size:10px; font-weight:600;}
  .traffic{color:var(--red); font-size:10px; font-weight:600;}
  .clock{display:flex;align-items:center;gap:4px;font-size:11px;font-weight:700;}
  .phase{font-size:9px;color:var(--muted);text-align:right;}
  .dayLbl{font-size:9px;color:var(--muted);text-align:right;}
  .townLvl{font-size:11px;font-weight:800;color:var(--gold);background:rgba(251,191,36,0.15);
    padding:2px 8px;border-radius:8px;border:1px solid rgba(251,191,36,0.35);}
  .pauseBtn{
    background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15);
    width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;
    font-size:14px; cursor:pointer; margin-left:6px; flex-shrink:0;
  }
  .hud-right{display:flex; align-items:flex-start;}

  #gameWrap{position:relative;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;}
  canvas{display:block;touch-action:none; border-radius:8px; box-shadow:0 8px 32px rgba(0,0,0,0.5);}

  .toast{
    position:absolute; top:6px; left:50%; transform:translateX(-50%);
    background:rgba(10,14,23,0.94); border:1px solid rgba(255,255,255,0.15);
    padding:6px 14px; border-radius:18px; font-size:11px; letter-spacing:0.3px;
    z-index:20; opacity:0; transition:opacity 0.25s, transform 0.25s; pointer-events:none;
    white-space:nowrap; max-width:90%; text-align:center;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(3px); }

  #buildFab{
    position:absolute; right:12px; bottom:12px; z-index:8;
    display:flex; flex-direction:column; align-items:center; gap:1px;
    background:linear-gradient(135deg,#22d3ee,#4ade80); color:#031018;
    width:54px; height:54px; border-radius:16px;
    box-shadow:0 6px 18px rgba(0,0,0,0.45), 0 0 18px rgba(74,222,128,0.3);
    cursor:pointer; justify-content:center;
  }
  #buildFab .ic{ font-size:20px; line-height:1; }
  #buildFab .lbl{ font-size:7px; font-weight:800; letter-spacing:0.4px; }
  #buildFab .badge{
    position:absolute; top:-5px; left:-5px; background:#0f172a; border:1.5px solid #4ade80;
    border-radius:7px; font-size:11px; padding:1px 3px;
  }

  .sheet{
    position:absolute; inset:0; z-index:25; display:none;
    align-items:flex-end; justify-content:center;
    background:rgba(4,6,12,0.55);
  }
  .sheet.open{ display:flex; }
  .sheet-card{
    width:100%; max-height:78%; background:var(--panel); border-radius:18px 18px 0 0;
    padding:12px 10px calc(12px + env(safe-area-inset-bottom)) 10px; overflow-y:auto;
    border-top:1px solid rgba(255,255,255,0.1);
  }
  .sheet-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; padding:0 4px;}
  .sheet-head h3{ margin:0; font-size:14px; letter-spacing:0.4px; }
  .sheet-close{ background:rgba(255,255,255,0.08); border:none; color:var(--ink); width:26px;height:26px;
    border-radius:7px; font-size:13px; cursor:pointer; }
  .tool-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:6px; }
  .tool{
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
    background:var(--panel2); border:1.5px solid transparent; border-radius:12px;
    padding:9px 3px; cursor:pointer; color:var(--ink);
  }
  .tool .ic{font-size:18px;}
  .tool .lbl{font-size:9px; letter-spacing:0.15px; color:var(--ink); font-weight:700;}
  .tool .cost{font-size:8.5px; color:var(--gold); font-weight:700;}
  .tool.active{ border-color:var(--blue); background:#1e2c4d; box-shadow:0 0 10px rgba(56,189,248,0.3); }
  .tool.locked{ opacity:0.38; }

  .overlay{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
    background:rgba(5,7,16,0.93); backdrop-filter:blur(6px); z-index:30; text-align:center; padding:22px;
  }
  .overlay h1{ font-size:24px; margin:0 0 5px 0; letter-spacing:1px;
    background:linear-gradient(90deg,#fbbf24,#4ade80); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .overlay .sub{ color:var(--muted); font-size:12px; margin-bottom:16px; line-height:1.65; max-width:310px;}
  .overlay .sub b{ color:var(--ink); }
  .play-btn{ background:linear-gradient(135deg,#4ade80,#22d3ee); color:#031018; border:none; font-weight:800;
    font-size:14px; padding:12px 28px; border-radius:24px; cursor:pointer; box-shadow:0 0 22px rgba(74,222,128,0.3); margin:4px;}
  .play-btn:active{ transform:scale(0.96); }
  .ghost-btn{
    background:transparent; border:1.5px solid rgba(255,255,255,0.25); color:var(--ink);
    font-weight:700; font-size:12px; padding:10px 22px; border-radius:20px; cursor:pointer; margin:4px;
  }
  .ghost-btn:active{ transform:scale(0.96); }
  .howto-body{ text-align:left; max-width:330px; font-size:11.5px; color:var(--muted); line-height:1.75; max-height:50vh; overflow-y:auto; margin-bottom:12px;}
  .howto-body b{ color:var(--ink); }
  .howto-body .sec{ color:var(--gold); font-weight:700; margin-top:8px; display:block; }
  .btnrow{ display:flex; flex-wrap:wrap; justify-content:center; }
  .goal-bar{
    width:90%; max-width:280px; height:10px; background:rgba(255,255,255,0.1); border-radius:6px;
    margin:8px auto 4px; overflow:hidden;
  }
  .goal-fill{ height:100%; background:linear-gradient(90deg,#fbbf24,#4ade80); border-radius:6px; transition:width 0.4s; }
  .goal-txt{ font-size:11px; color:var(--muted); }
</style>
</head>
<body>
<div id="stage"><div id="frame">

  <div class="hud">
    <div class="hud-col">
      <div class="stat cash"><span class="ic">$</span><span id="cashEl">0</span></div>
      <div class="stat pop"><span class="ic">👥</span><span id="popEl">0</span></div>
      <div class="stat edu"><span class="ic">📚</span><span id="eduEl">0</span></div>
      <div class="income" id="incomeEl">+$0/s</div>
      <div class="traffic" id="trafficEl"></div>
    </div>
    <div class="hud-col" style="align-items:center; gap:4px;">
      <div class="townLvl" id="townLvlEl">Town Lv 1</div>
      <div class="goal-bar"><div class="goal-fill" id="goalFill" style="width:10%"></div></div>
      <div class="goal-txt" id="goalTxt">Goal: Level 10</div>
      <div class="goal-txt" id="missionEl" style="color:#38bdf8; font-size:10px; margin-top:2px;">Mission: Buy 4 land tiles</div>
    </div>
    <div class="hud-right">
      <div class="hud-col" style="align-items:flex-end;">
        <div class="clock"><span id="clockIcon">☀️</span><span id="clockEl">06:00</span></div>
        <div class="phase" id="phaseEl">Morning</div>
        <div class="dayLbl" id="dayEl">Day 1</div>
      </div>
      <div class="pauseBtn" id="pauseBtn">⏸</div>
    </div>
  </div>

  <div id="gameWrap">
    <canvas id="game"></canvas>
    <div class="toast" id="toast"></div>
    <div id="buildFab">
      <div class="badge" id="fabBadge">🗺️</div>
      <div class="ic">🔨</div>
      <div class="lbl">BUILD</div>
    </div>
  </div>

  <div class="sheet" id="sheet">
    <div class="sheet-card">
      <div class="sheet-head">
        <h3>Choose a tool</h3>
        <button class="sheet-close" id="sheetClose">✕</button>
      </div>
      <div class="tool-grid" id="toolGrid"></div>
    </div>
  </div>

    
  <div class="overlay" id="profileOverlay" style="display:flex; background:linear-gradient(180deg,#0a0610 0%,#1a1028 50%,#0a1520 100%);">
    <div style="font-size:11px; letter-spacing:3px; color:#fbbf24; margin-bottom:8px; opacity:0.9;">NEO FORGE GAMES</div>
    <h1 style="font-size:26px; letter-spacing:2px; background:linear-gradient(90deg,#f59e0b,#fbbf24,#fef3c7); -webkit-background-clip:text; background-clip:text; color:transparent;">FORGE POWER LAND</h1>
    <div class="sub" style="margin:12px 0 16px;">Create your profile to begin your journey.<br>Your name will appear in missions and city reports.</div>
    <input id="nameInput" type="text" maxlength="16" placeholder="Enter your name..." 
      style="background:#1a2540; border:1.5px solid rgba(251,191,36,0.4); color:#eaf1ff; 
      padding:12px 18px; border-radius:12px; font-size:15px; width:min(280px,80vw); text-align:center;
      outline:none; margin-bottom:16px;" />
    <div class="btnrow">
      <button class="play-btn" id="createProfileBtn">CREATE PROFILE</button>
    </div>
    <div style="position:absolute; bottom:18px; font-size:10px; color:rgba(255,255,255,0.35);">MADE BY NEO FORGE GAMES</div>
  </div>

  <div class="overlay" id="startOverlay" style="display:none;" style="background:linear-gradient(180deg,#1a0a00 0%,#3a1a08 40%,#0a1520 100%);">
    <div style="font-size:11px; letter-spacing:3px; color:#fbbf24; margin-bottom:6px; opacity:0.9;">NEO FORGE GAMES PRESENTS</div>
    <h1 style="font-size:26px; letter-spacing:2px; background:linear-gradient(90deg,#f59e0b,#fbbf24,#fef3c7,#f59e0b); -webkit-background-clip:text; background-clip:text; color:transparent;">FORGE POWER LAND</h1>
    <div class="sub" style="margin-top:6px;">Build from Village to Power Land.<br>Complete missions • Unlock industry • Manage crime.</div>
    
    <div id="profileBox" style="margin:14px 0; width:90%; max-width:280px;">
      <div style="font-size:12px; color:#94a3b8; margin-bottom:6px; text-align:left;">Create your profile</div>
      <input id="nameInput" type="text" maxlength="16" placeholder="Enter your name..." 
        style="width:100%; padding:10px 12px; border-radius:10px; border:1.5px solid rgba(255,255,255,0.2);
        background:rgba(0,0,0,0.4); color:#eaf1ff; font-size:14px; outline:none; box-sizing:border-box;" />
    </div>
    
    <div class="btnrow">
      <button class="play-btn" id="playBtn">ENTER THE LAND</button>
      <button class="ghost-btn" id="howtoBtnStart">How to Play</button>
    </div>
    <div style="position:absolute; bottom:16px; font-size:10px; color:rgba(255,255,255,0.35); letter-spacing:1px;">MADE BY NEO FORGE GAMES</div>
  </div>

<div class="overlay" id="howtoOverlay" style="display:none;">
    <h1 style="font-size:20px;">How to Play</h1>
    <div class="howto-body">
      <span class="sec">Goal</span>
      Grow from <b>Village</b> to <b>Power Land</b> (Level 10). Complete missions to progress.
      <span class="sec">Profile</span>
      Enter your name at the start. Missions will address you personally.
      <span class="sec">Land</span>
      Buy land next to owned tiles. Price rises with distance from Town Hall. Mountains can be bought for mines.
      <span class="sec">Terrain Rules</span>
      <b>Oil Refinery</b> — only on Desert. <b>Ore Mine</b> — only on Mountains. Rivers cannot be built on.
      <span class="sec">Industry Limits</span>
      Early levels limit how many factories/mines you can build. Limits rise as your city ranks up.
      <span class="sec">Crime &amp; Safety</span>
      High population without enough Police/Fire raises crime and cuts income. Watch the demand messages.
      <span class="sec">Education</span>
      Schools, Library, High School, University and Museum raise Education and unlock advanced buildings.
      <span class="sec">Traffic</span>
      Too many houses and shops without roads or a Train Station reduces income.
      <span class="sec">Big Buildings</span>
      Airport, Statue and Train Station need 2×2 empty owned land.
    </div>
    <button class="play-btn" id="howtoCloseBtn">Got it</button>
  </div>

  <div class="overlay" id="pauseOverlay" style="display:none;">
    <h1 style="font-size:22px;">Paused</h1>
    <div class="sub">Your land awaits your command.</div>
    <div class="btnrow">
      <button class="play-btn" id="resumeBtn">Resume</button>
      <button class="ghost-btn" id="howtoBtnPause">How to Play</button>
      <button class="ghost-btn" id="restartBtn">New City</button>
      <button class="ghost-btn" id="quitBtn" style="border-color:rgba(248,113,113,0.4); color:#f87171;">Quit</button>
    </div>
  </div>

  <div class="overlay" id="winOverlay" style="display:none;">
    <h1>🎉 Town Level 10!</h1>
    <div class="sub">Congratulations! You forged a powerful land.</div>
    <div class="btnrow">
      <button class="play-btn" id="winContinue">Keep Playing</button>
      <button class="ghost-btn" id="winNew">New City</button>
    </div>
  </div>

</div></div>

<script>
(function(){
"use strict";

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const gameWrap = document.getElementById('gameWrap');
let DPR = Math.min(window.devicePixelRatio||1, 2);
let W, H, tile;

const GRID = 12;
const CENTER = 5;
const DAY_LENGTH = 1800;

function resize(){
  const rect = gameWrap.getBoundingClientRect();
  const size = Math.min(rect.width, rect.height) - 4;
  W = size; H = size;
  canvas.width = W * DPR; canvas.height = H * DPR;
  canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  tile = W / GRID;
}
window.addEventListener('resize', resize);

// ===================== BUILDINGS =====================
const BUILD = {
  // Housing
  hut:        { icon:'🛖', label:'Hut',          cost:60,   income:0.8,  cap:2,  edu:0,  buildT:1.5, unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  house:      { icon:'🏠', label:'House',        cost:140,  income:1.8,  cap:4,  edu:0,  buildT:2.5, unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  villa:      { icon:'🏡', label:'Villa',        cost:380,  income:4.5,  cap:7,  edu:0,  buildT:4,   unlockEdu:0,  unlockPop:12, unlockTown:2 },
  apartment:  { icon:'🏢', label:'Apartment',    cost:520,  income:6.5,  cap:12, edu:0,  buildT:5,   unlockEdu:0,  unlockPop:20, unlockTown:3 },
  // Commerce
  shop:       { icon:'🏪', label:'Shop',         cost:260,  income:5,    cap:0,  edu:0,  buildT:3,   unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  cafe:       { icon:'☕', label:'Cafe',         cost:290,  income:5.8,  cap:0,  edu:0,  buildT:3,   unlockEdu:0,  unlockPop:6,  unlockTown:2 },
  restaurant: { icon:'🍽️', label:'Restaurant',   cost:320,  income:6.5,  cap:0,  edu:0,  buildT:3.5, unlockEdu:0,  unlockPop:8,  unlockTown:2 },
  fuel:       { icon:'⛽', label:'Fuel Station', cost:280,  income:5.5,  cap:0,  edu:0,  buildT:3,   unlockEdu:0,  unlockPop:5,  unlockTown:2 },
  cinema:     { icon:'🎬', label:'Cinema',       cost:720,  income:14,   cap:0,  edu:0,  buildT:5.5, unlockEdu:5,  unlockPop:22, unlockTown:3 },
  // Industry & Jobs
  factory:    { icon:'🏭', label:'Factory',      cost:480,  income:12,   cap:0,  edu:0,  buildT:4.5, unlockEdu:0,  unlockPop:0,  unlockTown:2 },
  warehouse:  { icon:'📦', label:'Warehouse',    cost:420,  income:9,    cap:0,  edu:0,  buildT:4,   unlockEdu:0,  unlockPop:10, unlockTown:2 },
  oil:        { icon:'🛢️', label:'Oil Refinery', cost:900,  income:22,   cap:0,  edu:0,  buildT:6,   unlockEdu:0,  unlockPop:15, unlockTown:3, terrain:'desert' },
  mine:       { icon:'⛏️', label:'Ore Mine',     cost:750,  income:18,   cap:0,  edu:0,  buildT:5.5, unlockEdu:0,  unlockPop:12, unlockTown:3, terrain:'mountain' },
  office:     { icon:'🏢', label:'Office',       cost:550,  income:11,   cap:0,  edu:0,  buildT:5,   unlockEdu:5,  unlockPop:15, unlockTown:3 },
  bank:       { icon:'🏦', label:'Bank',         cost:700,  income:16,   cap:0,  edu:0,  buildT:5,   unlockEdu:10, unlockPop:25, unlockTown:4 },
  // Education
  school:     { icon:'🏫', label:'School',       cost:350,  income:1,    cap:0,  edu:3,  buildT:4,   unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  library:    { icon:'📚', label:'Library',      cost:480,  income:1.5,  cap:0,  edu:6,  buildT:4.5, unlockEdu:4,  unlockPop:12, unlockTown:2 },
  highschool: { icon:'🎓', label:'High School',  cost:600,  income:2,    cap:0,  edu:7,  buildT:5,   unlockEdu:8,  unlockPop:20, unlockTown:3 },
  university: { icon:'🏛️', label:'University',  cost:1100, income:4,    cap:0,  edu:15, buildT:7,   unlockEdu:18, unlockPop:40, unlockTown:5 },
  museum:     { icon:'🖼️', label:'Museum',       cost:850,  income:8,    cap:0,  edu:5,  buildT:6,   unlockEdu:12, unlockPop:28, unlockTown:4 },
  // Health & Safety
  clinic:     { icon:'🏥', label:'Clinic',       cost:300,  income:2,    cap:0,  edu:0,  buildT:3,   unlockEdu:0,  unlockPop:5,  unlockTown:2 },
  hospital:   { icon:'🏨', label:'Hospital',     cost:800,  income:5,    cap:0,  edu:0,  buildT:6,   unlockEdu:12, unlockPop:30, unlockTown:4 },
  police:     { icon:'🚓', label:'Police',       cost:400,  income:2.5,  cap:0,  edu:0,  buildT:4,   unlockEdu:0,  unlockPop:10, unlockTown:2 },
  fire:       { icon:'🚒', label:'Fire Station', cost:420,  income:2.5,  cap:0,  edu:0,  buildT:4,   unlockEdu:0,  unlockPop:12, unlockTown:3 },
  graveyard:  { icon:'🪦', label:'Graveyard',    cost:180,  income:0.5,  cap:0,  edu:0,  buildT:2,   unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  // Transport
  road:       { icon:'🛣️', label:'Road',         cost:18,   income:0,    cap:0,  edu:0,  buildT:0.4, unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  train:      { icon:'🚉', label:'Train Station',cost:900,  income:8,    cap:0,  edu:0,  buildT:6,   unlockEdu:5,  unlockPop:20, unlockTown:3, size:2 },
  // Tourism
  hotel:      { icon:'🏩', label:'Hotel',        cost:650,  income:10,   cap:0,  edu:0,  buildT:5,   unlockEdu:0,  unlockPop:18, unlockTown:3 },
  statue:     { icon:'🗽', label:'Statue Unity', cost:1500, income:25,   cap:0,  edu:0,  buildT:8,   unlockEdu:0,  unlockPop:35, unlockTown:4, size:2 },
  // Big
  airport:    { icon:'✈️', label:'Airport',      cost:1400, income:40,   cap:0,  edu:0,  buildT:8,   unlockEdu:10, unlockPop:45, unlockTown:5, size:2 },
  // Parks & Hall
  park:       { icon:'🌳', label:'Park',         cost:100,  income:0,    cap:0,  edu:0,  buildT:1.5, unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  playground: { icon:'🎠', label:'Playground',   cost:160,  income:0.5,  cap:0,  edu:0,  buildT:2,   unlockEdu:0,  unlockPop:0,  unlockTown:1 },
  townhall:   { icon:'🏛️', label:'Town Hall',    cost:0,    income:4,    cap:0,  edu:0,  buildT:0,   unlockEdu:0,  unlockPop:0,  unlockTown:1 },
};

const HOUSE_TYPES = ['hut','house','villa','apartment'];
const TRAFFIC_TYPES = ['hut','house','villa','apartment','restaurant','fuel','cafe','cinema'];

// ===================== STATE =====================
let grid, cash, population, education, incomeRate, trafficPenalty, townLevel, floaters, running, paused, won;
let totalElapsed = 0, animTime = 0, tool = 'buy';
let cars = [];
let cats = [];
let missionIndex = 0;
let playerName = 'Mayor';
let crime = 0, happiness = 80;
let demandPolice = false, demandTraffic = false;

const LEVEL_NAMES = [
  '', 'Village', 'Small Town', 'Town', 'Large Town', 'City',
  'Big City', 'Metropolis', 'Capital', 'Megacity', 'Forge Capital'
];

const LEVEL_LIMITS = {
  // max factories / warehouses / oil / mines per town level
  factory:  [0,0,1,2,4,8,12,16,20,24,30],
  warehouse:[0,0,1,2,3,6,10,14,18,22,28],
  oil:      [0,0,0,1,2,3,5,7,9,12,15],
  mine:     [0,0,0,1,2,3,5,7,9,12,15],
  airport:  [0,0,0,0,0,1,1,1,2,2,2],
  statue:   [0,0,0,0,1,1,1,2,2,2,3],
  train:    [0,0,0,1,1,2,2,2,3,3,3],
};
let playerName = 'Mayor';
let crime = 0;
let happiness = 100;

const LEVEL_NAMES = [
  '', 'Village', 'Small Town', 'Town', 'Growing City', 'City',
  'Large City', 'Metropolis', 'Capital', 'Megacity', 'Power Land'
];

function maxFactories(){
  // Level 1-2: 0 big industry, then grows
  if(townLevel < 3) return 0;
  if(townLevel < 5) return 4;
  if(townLevel < 7) return 10;
  if(townLevel < 9) return 16;
  return 25;
}
function maxBigBuildings(){
  if(townLevel < 4) return 0;
  if(townLevel < 6) return 2;
  if(townLevel < 8) return 5;
  return 10;
}
const MISSIONS = [
  { text: () => `${playerName}, buy 4 land tiles to expand your Village`, check: () => { let n=0; for(let r=0;r<GRID;r++) for(let c=0;c<GRID;c++) if(grid[r][c].owned) n++; return n>=5; } },
  { text: () => `${playerName}, build 3 homes for your people`, check: () => countType('hut')+countType('house')+countType('villa')+countType('apartment') >= 3 },
  { text: () => `Connect the Village — place 6 roads`, check: () => countType('road') >= 6 },
  { text: () => `Open a School so education can grow`, check: () => countType('school') >= 1 },
  { text: () => `Reach Town status (Level 3)`, check: () => townLevel >= 3 },
  { text: () => `Build your first Factory or Warehouse`, check: () => countType('factory')+countType('warehouse') >= 1 },
  { text: () => `Create green space — 2 Parks or Playgrounds`, check: () => countType('park')+countType('playground') >= 2 },
  { text: () => `Reach City status (Level 5)`, check: () => townLevel >= 5 },
  { text: () => `Build a Hotel or Cinema for tourism`, check: () => countType('hotel')+countType('cinema') >= 1 },
  { text: () => `Extract resources — build an Oil Refinery (Desert) or Ore Mine (Mountain)`, check: () => countType('oil')+countType('mine') >= 1 },
  { text: () => `Keep the peace — build a Police Station`, check: () => countType('police') >= 1 },
  { text: () => `Reach Metropolis (Level 7)`, check: () => townLevel >= 7 },
  { text: () => `Build a University or Museum`, check: () => countType('university')+countType('museum') >= 1 },
  { text: () => `Reach Megacity (Level 9)`, check: () => townLevel >= 9 },
  { text: () => `Claim the ultimate title — reach Power Land (Level 10)!`, check: () => townLevel >= 10 },
];
const CAR_COLORS = ['#ef4444','#3b82f6','#22c55e','#f59e0b','#a855f7','#ec4899','#14b8a6','#f97316','#e11d48','#0ea5e9','#84cc16','#eab308','#8b5cf6','#f43f5e','#06b6d4','#65a30d','#d97706','#7c3aed','#db2777','#0891b2','#ca8a04','#4f46e5','#be123c','#0284c7','#16a34a','#c026d3'];
const CAT_COLORS = ['#f5a623','#e8e8e8','#4a3728','#c0c0c0','#f0c080','#2c2c2c','#d4a574'];

function rnd(a,b){ return a + Math.random()*(b-a); }
function ri(a,b){ return Math.floor(rnd(a,b+1)); }
function inBounds(r,c){ return r>=0 && r<GRID && c>=0 && c<GRID; }
function dist(r,c){ return Math.abs(r-CENTER) + Math.abs(c-CENTER); }

function generateTerrain(g){
  // River
  let col = ri(2, GRID-3);
  for(let r=0;r<GRID;r++){
    if(!(r===CENTER && Math.abs(col-CENTER)<=1)) g[r][col].type = 'river';
    if(Math.random()<0.5) col += (Math.random()<0.5?-1:1);
    col = Math.max(1, Math.min(GRID-2, col));
  }
  // Mountains
  const blobs = ri(2,3);
  for(let b=0;b<blobs;b++){
    let tries=0, or_, oc_;
    do{ or_=ri(0,GRID-1); oc_=ri(0,GRID-1); tries++; } while(dist(or_,oc_)<4 && tries<50);
    const seeds=[[or_,oc_]];
    for(let i=0;i<ri(5,9);i++){
      const [pr,pc]=seeds[ri(0,seeds.length-1)];
      const nr=pr+ri(-1,1), nc=pc+ri(-1,1);
      if(inBounds(nr,nc) && dist(nr,nc)>=4 && g[nr][nc].type==='plain'){
        g[nr][nc].type='mountain'; seeds.push([nr,nc]);
      }
    }
  }
  // Desert
  {
    let tries=0, or_, oc_;
    do{ or_=ri(0,GRID-1); oc_=ri(0,GRID-1); tries++; } while(dist(or_,oc_)<4 && tries<50);
    const seeds=[[or_,oc_]];
    if(g[or_][oc_].type==='plain') g[or_][oc_].type='desert';
    for(let i=0;i<ri(6,11);i++){
      const [pr,pc]=seeds[ri(0,seeds.length-1)];
      const nr=pr+ri(-1,1), nc=pc+ri(-1,1);
      if(inBounds(nr,nc) && dist(nr,nc)>=4 && g[nr][nc].type==='plain'){
        g[nr][nc].type='desert'; seeds.push([nr,nc]);
      }
    }
  }
  // Clear center
  for(let dr=-2;dr<=2;dr++) for(let dc=-2;dc<=2;dc++){
    const r=CENTER+dr, c=CENTER+dc;
    if(inBounds(r,c) && g[r][c].type!=='plain') g[r][c].type='plain';
  }
}

function newGrid(){
  const g=[];
  for(let r=0;r<GRID;r++){
    const row=[];
    for(let c=0;c<GRID;c++){
      row.push({type:'plain',owned:false,building:null,underConstruction:false,buildTimer:0,pulse:0,airportAnchor:null,isAnchor:false});
    }
    g.push(row);
  }
  generateTerrain(g);
  g[CENTER][CENTER].owned=true;
  g[CENTER][CENTER].building={type:'townhall'};
  return g;
}

function resetGame(){
  grid=newGrid();
  cash=900;
  population=0;
  education=0;
  incomeRate=0;
  trafficPenalty=1;
  townLevel=1;
  floaters=[];
  cars=[];
  cats=[];
  missionIndex=0;
  crime=0;
  happiness=100;
  totalElapsed=0;
  running=true;
  paused=false;
  won=false;
  tool='buy';
}

// ===================== TOOLS =====================
const TOOL_LIST = [
  'buy','road','hut','house','villa','apartment','shop','cafe','restaurant','fuel','cinema',
  'park','playground','factory','warehouse','oil','mine','office','bank','school','library','highschool','university','museum',
  'clinic','hospital','police','fire','graveyard','hotel','train','statue','airport','bulldoze'
];

const TOOL_META = {};
for(const k of TOOL_LIST){
  if(k==='buy') TOOL_META[k]={icon:'🗺️',label:'Buy Land'};
  else if(k==='bulldoze') TOOL_META[k]={icon:'🧨',label:'Demolish'};
  else {
    const b=BUILD[k];
    TOOL_META[k]={icon:b.icon,label:b.label,cost:b.cost,unlockEdu:b.unlockEdu,unlockPop:b.unlockPop,unlockTown:b.unlockTown};
  }
}

function isUnlocked(key){
  if(key==='buy'||key==='bulldoze'||key==='road'||key==='hut'||key==='house'||key==='park'||key==='shop'||key==='graveyard') return true;
  const m=TOOL_META[key];
  if(!m) return false;
  if(m.unlockEdu && education < m.unlockEdu) return false;
  if(m.unlockPop && population < m.unlockPop) return false;
  if(m.unlockTown && townLevel < m.unlockTown) return false;
  return true;
}

function buildToolbar(){
  const gridEl=document.getElementById('toolGrid');
  gridEl.innerHTML='';
  for(const key of TOOL_LIST){
    const meta=TOOL_META[key];
    const locked=!isUnlocked(key);
    const btn=document.createElement('div');
    btn.className='tool'+(tool===key?' active':'')+(locked?' locked':'');
    btn.dataset.tool=key;
    let costLine;
    if(key==='bulldoze') costLine=`<div class="cost" style="color:#f87171;">-50% back</div>`;
    else if(key==='buy') costLine=`<div class="cost">price varies</div>`;
    else if(locked){
      let req=[];
      if(meta.unlockEdu) req.push('Edu '+meta.unlockEdu);
      if(meta.unlockPop) req.push('Pop '+meta.unlockPop);
      if(meta.unlockTown) req.push('Town '+meta.unlockTown);
      costLine=`<div class="cost">🔒 ${req.join('/')}</div>`;
    } else costLine=`<div class="cost">$${meta.cost}</div>`;
    btn.innerHTML=`<div class="ic">\( {meta.icon}</div><div class="lbl"> \){meta.label}</div>`+costLine;
    btn.addEventListener('click',()=>{
      if(locked){ showToast(meta.label+' locked'); return; }
      tool=key;
      refreshToolbar();
      document.getElementById('fabBadge').textContent=meta.icon;
      closeSheet();
    });
    gridEl.appendChild(btn);
  }
}
function refreshToolbar(){
  document.querySelectorAll('.tool').forEach(el=>el.classList.toggle('active',el.dataset.tool===tool));
}

const sheet=document.getElementById('sheet');
const buildFab=document.getElementById('buildFab');
function openSheet(){ sheet.classList.add('open'); }
function closeSheet(){ sheet.classList.remove('open'); }
buildFab.addEventListener('click',openSheet);
document.getElementById('sheetClose').addEventListener('click',closeSheet);
sheet.addEventListener('click',e=>{ if(e.target===sheet) closeSheet(); });

// ===================== HELPERS =====================
function landCost(r,c){
  const base=55 + dist(r,c)*28;
  if(grid[r][c].type==='desert') return Math.round(base*0.7);
  return base;
}
function neighbors(r,c){
  return [[r-1,c],[r+1,c],[r,c-1],[r,c+1]].filter(([rr,cc])=>inBounds(rr,cc));
}
function isBuyable(r,c){
  const t=grid[r][c];
  if(t.owned) return false;
  if(t.type==='river') return false;
  // mountains can be bought (for mines), desert already allowed
  return neighbors(r,c).some(([rr,cc])=>grid[rr][cc].owned);
}
function hasAdjacent(r,c,type){
  return neighbors(r,c).some(([rr,cc])=>{
    const t=grid[rr][cc];
    return t.building && !t.underConstruction && t.building.type===type;
  });
}
function countAdjacent(r,c,type){
  return neighbors(r,c).filter(([rr,cc])=>{
    const t=grid[rr][cc];
    return t.building && !t.underConstruction && t.building.type===type;
  }).length;
}
function hasWater(r,c){
  return neighbors(r,c).some(([rr,cc])=>grid[rr][cc].type==='river');
}
function countType(type){
  let n=0;
  for(let r=0;r<GRID;r++) for(let c=0;c<GRID;c++){
    const t=grid[r][c];
    if(t.building && !t.underConstruction && t.building.type===type){
      if((type==='airport'||type==='statue'||type==='train') && !t.isAnchor) continue;
      n++;
    }
  }
  return n;
}

let toastTimer=null;
function showToast(msg){
  const el=document.getElementById('toast');
  el.textContent=msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('show'),1600);
}
function addFloater(r,c,text,color){
  floaters.push({r,c,text,color,t:0,life:1.1});
}

// ===================== PLACE BIG =====================
function tryPlaceBig(r,c,type){
  const def=BUILD[type];
  if(r+1>=GRID||c+1>=GRID){ showToast('Not enough room'); return; }
  const cells=[[r,c],[r,c+1],[r+1,c],[r+1,c+1]];
  for(const [rr,cc] of cells){
    const t=grid[rr][cc];
    if(!t.owned){ showToast('Own all 4 tiles first'); return; }
    if(t.building){ showToast('Area must be empty'); return; }
    if(t.type==='mountain'||t.type==='river'){ showToast('Needs flat land'); return; }
  }
  if(cash<def.cost){ showToast('Need $'+def.cost); return; }
  cash-=def.cost;
  for(const [rr,cc] of cells){
    grid[rr][cc].building={type};
    grid[rr][cc].underConstruction=true;
    grid[rr][cc].buildTimer=def.buildT;
    grid[rr][cc].airportAnchor=[r,c];
    grid[rr][cc].isAnchor=(rr===r&&cc===c);
  }
  addFloater(r,c,'-$'+def.cost,'#f87171');
}

function demolishAt(r,c){
  const t=grid[r][c];
  if(!t.building||t.building.type==='townhall'){ showToast('Nothing to demolish'); return; }
  const type=t.building.type;
  if(type==='airport'||type==='statue'||type==='train'){
    const [ar,ac]=t.airportAnchor;
    const def=BUILD[type];
    const refund=Math.floor(def.cost*0.5);
    cash+=refund;
    for(let rr=ar;rr<=ar+1;rr++) for(let cc=ac;cc<=ac+1;cc++){
      grid[rr][cc].building=null; grid[rr][cc].underConstruction=false;
      grid[rr][cc].airportAnchor=null; grid[rr][cc].isAnchor=false;
    }
    addFloater(ar,ac,'+$'+refund,'#4ade80');
    return;
  }
  const def=BUILD[type];
  const refund=Math.floor(def.cost*0.5);
  cash+=refund;
  t.building=null; t.underConstruction=false;
  addFloater(r,c,'+$'+refund,'#4ade80');
}

function handleTileTap(r,c){
  if(!running||paused) return;
  const t=grid[r][c];
  if(tool==='bulldoze'){ demolishAt(r,c); return; }
  if(t.type==='river'){ showToast("River — water source"); return; }
  if(t.type==='mountain' && tool !== 'mine' && tool !== 'buy' && tool !== 'bulldoze'){
    showToast("Only Ore Mines on mountains"); return;
  }
  if(t.type==='desert' && tool === 'oil'){ /* allowed */ }
  else if(tool === 'oil' && t.type !== 'desert'){ /* will be caught later */ }

  if(tool==='buy'){
    if(t.owned){ showToast('Already owned'); return; }
    if(!isBuyable(r,c)){ showToast('Buy next to owned land'); return; }
    const cost=landCost(r,c);
    if(cash<cost){ showToast('Need $'+cost); return; }
    cash-=cost; t.owned=true; t.pulse=1;
    addFloater(r,c,'-$'+cost,'#f87171');
    return;
  }

  if(['airport','statue','train'].includes(tool)){
    if(!isUnlocked(tool)){ showToast(TOOL_META[tool].label+' locked'); return; }
    tryPlaceBig(r,c,tool);
    return;
  }

  if(!isUnlocked(tool)){ showToast(TOOL_META[tool].label+' locked'); return; }
  const def=BUILD[tool];
  if(!t.owned){ showToast('Buy land first'); return; }
  if(t.building){ showToast('Already has building'); return; }
  if(cash<def.cost){ showToast('Need $'+def.cost); return; }

  // Terrain restrictions
  if(def.terrain === 'desert' && t.type !== 'desert'){
    showToast('Oil Refinery only on Desert'); return;
  }
  if(def.terrain === 'mountain' && t.type !== 'mountain'){
    showToast('Ore Mine only on Mountain'); return;
  }
  // Note: mountain tiles are normally not ownable — we allow special case below

  // Factory / industry limits
  const industryTypes = ['factory','warehouse','oil','mine'];
  if(industryTypes.includes(tool)){
    let totalInd = 0;
    for(const ty of industryTypes) totalInd += countType(ty);
    if(totalInd >= maxFactories()){
      showToast('Industry limit reached (Level ' + townLevel + ')'); return;
    }
  }
  // Big buildings limit
  const bigTypes = ['airport','statue','train','university','hotel','cinema'];
  if(bigTypes.includes(tool)){
    let totalBig = 0;
    for(const ty of bigTypes) totalBig += countType(ty);
    if(totalBig >= maxBigBuildings()){
      showToast('Big building limit for this level'); return;
    }
  }

  cash-=def.cost;
  t.building={type:tool};
  t.underConstruction=true;
  t.buildTimer=def.buildT;
  addFloater(r,c,'-$'+def.cost,'#f87171');
}

canvas.addEventListener('click',e=>{
  const rect=canvas.getBoundingClientRect();
  const x=e.clientX-rect.left, y=e.clientY-rect.top;
  const c=Math.floor(x/tile), r=Math.floor(y/tile);
  if(inBounds(r,c)) handleTileTap(r,c);
});
canvas.addEventListener('touchend',e=>{
  const rect=canvas.getBoundingClientRect();
  const t0=e.changedTouches[0];
  const x=t0.clientX-rect.left, y=t0.clientY-rect.top;
  const c=Math.floor(x/tile), r=Math.floor(y/tile);
  if(inBounds(r,c)) handleTileTap(r,c);
  e.preventDefault();
},{passive:false});

// ===================== ECONOMY =====================
function calcTownLevel(pop,edu){
  // Level 1-10 based on pop + edu
  const score = pop*0.6 + edu*1.8;
  if(score<8) return 1;
  if(score<18) return 2;
  if(score<32) return 3;
  if(score<50) return 4;
  if(score<72) return 5;
  if(score<100) return 6;
  if(score<135) return 7;
  if(score<175) return 8;
  if(score<220) return 9;
  return 10;
}

function economyTick(){
  let income = BUILD.townhall.income;
  let pop=0, edu=0;
  let trafficLoad=0, trafficRelief=0;

  for(let r=0;r<GRID;r++){
    for(let c=0;c<GRID;c++){
      const t=grid[r][c];
      if(!t.building||t.underConstruction) continue;
      const type=t.building.type;
      if(type==='townhall'||type==='road'||type==='park'||type==='graveyard') continue;
      if((type==='airport'||type==='statue'||type==='train') && !t.isAnchor) continue;

      const def=BUILD[type];
      let amt=def.income;

      if(HOUSE_TYPES.includes(type)) pop += def.cap;
      if(def.edu) edu += def.edu;

      // Tourism bonus: statue & hotel boost nearby houses
      if(HOUSE_TYPES.includes(type)){
        if(hasAdjacent(r,c,'statue')||hasAdjacent(r,c,'hotel')) amt*=1.25;
      }

      // Shop needs road
      if(type==='shop'||type==='restaurant'||type==='fuel'){
        amt = hasAdjacent(r,c,'road') ? amt : amt*0.45;
      }

      // Water & desert
      if(type!=='airport'&&type!=='statue'&&type!=='train'){
        const water=hasWater(r,c);
        if(t.type==='desert') amt *= water?1.0:0.35;
        else if(water) amt*=1.12;
        const parks=countAdjacent(r,c,'park');
        if(parks>0) amt*=(1+Math.min(2,parks)*0.18);
        if(HOUSE_TYPES.includes(type)){
          const factories=countAdjacent(r,c,'factory');
          if(factories>0) amt*=Math.max(0.35,1-factories*0.22);
        }
      }

      // Traffic load
      if(TRAFFIC_TYPES.includes(type)) trafficLoad++;
      if(type==='road') trafficRelief+=0.7;
      if(type==='train') trafficRelief+=6;
      if(type==='police'||type==='fire') trafficRelief+=1.2;

      income+=amt;
    }
  }

  // Traffic penalty
  const needed = Math.max(1, trafficLoad*0.55);
  trafficPenalty = Math.max(0.35, Math.min(1, (trafficRelief+2)/needed));
  income *= trafficPenalty;

  // Crime & Happiness system
  const policeCount = countType('police');
  const popFactor = Math.max(0, population - 8);
  crime = Math.max(0, Math.min(100, Math.floor(popFactor * 1.8 - policeCount * 12 - countType('fire') * 4)));
  if(crime > 40 && policeCount === 0) demandPolice = true;
  else if(crime < 25) demandPolice = false;
  if(trafficPenalty < 0.7) demandTraffic = true;
  else demandTraffic = false;

  happiness = Math.max(20, Math.min(100, 90 - crime * 0.5 + (countType('park')+countType('playground'))*4 + education * 0.3));
  // Crime hurts income
  if(crime > 30) income *= Math.max(0.55, 1 - (crime-30)/150);
  // Show demands
  let demandMsg = '';
  if(demandPolice) demandMsg += '🚔 Need Police Station! ';
  if(demandTraffic) demandMsg += '🚦 Need more roads/trains! ';
  const trEl2 = document.getElementById('trafficEl');
  if(demandMsg) {
    trEl2.textContent = demandMsg.trim();
    trEl2.style.color = '#f87171';
  } else if(crime > 20) {
    trEl2.textContent = 'Crime: '+crime+'%';
    trEl2.style.color = '#fbbf24';
  }

  // Crime system
  let policeCount = countType('police');
  let fireCount = countType('fire');
  let safety = policeCount * 3 + fireCount * 1.5 + (countType('hospital')+countType('clinic')) * 0.8;
  let crimePressure = Math.max(0, population * 0.15 - safety);
  crime = Math.min(100, Math.max(0, crimePressure));
  if(crime > 40){
    income *= Math.max(0.5, 1 - (crime-40)/120);
  }
  happiness = Math.max(20, 100 - crime * 0.6 - (1-trafficPenalty)*30);

  // Demands calculated below

  // Education & pop bonuses
  income *= (1 + Math.min(0.4, education*0.008));
  // Hospital & clinic small income boost to houses already handled via presence

  incomeRate=income;
  cash+=income;
  population=pop;
  education=edu;
  const newLvl=calcTownLevel(pop,edu);
  if(newLvl>townLevel){
    townLevel=newLvl;
    showToast('🎉 Town Level '+townLevel+'!');
    if(townLevel>=10 && !won){
      won=true;
      document.getElementById('winOverlay').style.display='flex';
    }
  } else townLevel=newLvl;

  // UI
  document.getElementById('townLvlEl').textContent=(LEVEL_NAMES[townLevel]||('Level '+townLevel));
  document.getElementById('goalFill').style.width=(townLevel*10)+'%';
  document.getElementById('goalTxt').textContent=townLevel>=10?'Level 10 Reached!':'Goal: Level 10';
  // Missions
  if(missionIndex < MISSIONS.length){
    const m = MISSIONS[missionIndex];
    if(m.check()){
      missionIndex++;
      showToast('Mission complete!');
    }
    const next = MISSIONS[missionIndex];
    document.getElementById('missionEl').textContent = next ? next.text() : 'All missions complete!';
  } else {
    document.getElementById('missionEl').textContent = 'All missions complete!';
  }
  const trEl=document.getElementById('trafficEl');
  if(crime > 55){
    trEl.textContent='Crime high — build Police!';
  } else if(crime > 35){
    trEl.textContent='Crime rising — need Police';
  } else if(trafficPenalty < 0.75){
    trEl.textContent='Traffic -'+Math.round((1-trafficPenalty)*100)+'%';
  } else {
    trEl.textContent='';
  }
}

// ===================== CLOCK =====================
function dayPhase(){ return (totalElapsed%DAY_LENGTH)/DAY_LENGTH; }
function dayNumber(){ return Math.floor(totalElapsed/DAY_LENGTH)+1; }
function lightLevel(phase){ return Math.max(0,Math.sin((phase-0.25)*2*Math.PI)); }
function phaseLabel(hour){
  if(hour>=5&&hour<11) return ['Morning','🌅'];
  if(hour>=11&&hour<16) return ['Afternoon','☀️'];
  if(hour>=16&&hour<19) return ['Evening','🌇'];
  return ['Night','🌙'];
}
function updateClockUI(){
  const phase=dayPhase();
  const hourF=phase*24;
  const hh=Math.floor(hourF), mm=Math.floor((hourF-hh)*60);
  const [lbl,icon]=phaseLabel(hourF);
  document.getElementById('clockEl').textContent=String(hh).padStart(2,'0')+':'+String(mm).padStart(2,'0');
  document.getElementById('clockIcon').textContent=icon;
  document.getElementById('phaseEl').textContent=lbl;
  document.getElementById('dayEl').textContent='Day '+dayNumber();
}

// ===================== UPDATE =====================
let lastT=0, tickAcc=0;
function update(dt){
  totalElapsed+=dt; animTime+=dt; tickAcc+=dt;
  if(tickAcc>=1){
    tickAcc-=1;
    economyTick();
    buildToolbar();
  }
  updateClockUI();
  for(let r=0;r<GRID;r++) for(let c=0;c<GRID;c++){
    const t=grid[r][c];
    if(t.pulse>0) t.pulse=Math.max(0,t.pulse-dt*2);
    if(t.underConstruction){
      t.buildTimer-=dt;
      if(t.buildTimer<=0){
        t.underConstruction=false;
        if(!(t.building&&['airport','statue','train'].includes(t.building.type)&&!t.isAnchor)){
          addFloater(r,c,'Ready!','#4ade80');
        }
      }
    }
  }
  for(const f of floaters) f.t+=dt;
  floaters=floaters.filter(f=>f.t<f.life);

  // ----- Cars on roads -----
  // Spawn cars occasionally
  if(Math.random() < dt * 0.9 && cars.length < 18){
    const roadTiles = [];
    for(let r=0;r<GRID;r++) for(let c=0;c<GRID;c++){
      const t=grid[r][c];
      if(t.building && !t.underConstruction && t.building.type==='road') roadTiles.push([r,c]);
    }
    if(roadTiles.length > 0){
      const [sr,sc] = roadTiles[ri(0,roadTiles.length-1)];
      const dirs = [[0,1],[0,-1],[1,0],[-1,0]];
      const validDirs = dirs.filter(([dr,dc])=>{
        const nr=sr+dr, nc=sc+dc;
        return inBounds(nr,nc) && grid[nr][nc].building && grid[nr][nc].building.type==='road';
      });
      const dir = validDirs.length ? validDirs[ri(0,validDirs.length-1)] : dirs[ri(0,3)];
      cars.push({
        r: sr, c: sc, progress: 0,
        dr: dir[0], dc: dir[1],
        color: CAR_COLORS[ri(0,CAR_COLORS.length-1)],
        speed: 0.7 + Math.random()*0.9
      });
    }
  }
  // Move cars
  for(const car of cars){
    car.progress += car.speed * dt;
    if(car.progress >= 1){
      car.progress = 0;
      car.r += car.dr;
      car.c += car.dc;
      // try turn or continue
      if(!inBounds(car.r,car.c) || !(grid[car.r][car.c].building && grid[car.r][car.c].building.type==='road')){
        car.dead = true;
      } else {
        // maybe change direction at intersection
        if(Math.random() < 0.35){
          const dirs = [[0,1],[0,-1],[1,0],[-1,0]];
          const valid = dirs.filter(([dr,dc])=>{
            if(dr===-car.dr && dc===-car.dc) return false; // no U-turn
            const nr=car.r+dr, nc=car.c+dc;
            return inBounds(nr,nc) && grid[nr][nc].building && grid[nr][nc].building.type==='road';
          });
          if(valid.length){
            const d = valid[ri(0,valid.length-1)];
            car.dr = d[0]; car.dc = d[1];
          }
        }
      }
    }
  }
  cars = cars.filter(c => !c.dead);

  // ----- Cats -----
  if(Math.random() < dt * 0.35 && cats.length < 8){
    const spots = [];
    for(let r=0;r<GRID;r++) for(let c=0;c<GRID;c++){
      const t=grid[r][c];
      if(t.owned && t.building && !t.underConstruction &&
         (t.building.type==='park' || t.building.type==='playground' || t.building.type==='graveyard' || t.building.type==='road')){
        spots.push([r,c]);
      }
    }
    if(spots.length){
      const [sr,sc] = spots[ri(0,spots.length-1)];
      cats.push({
        r:sr, c:sc, progress:0,
        dr: [0,1,0,-1][ri(0,3)], dc: [1,0,-1,0][ri(0,3)],
        color: CAT_COLORS[ri(0,CAT_COLORS.length-1)],
        speed: 0.35 + Math.random()*0.4,
        sitTimer: 0,
        frame: 0
      });
    }
  }
  for(const cat of cats){
    if(cat.sitTimer > 0){
      cat.sitTimer -= dt;
      continue;
    }
    cat.progress += cat.speed * dt;
    cat.frame += dt * 6;
    if(cat.progress >= 1){
      cat.progress = 0;
      cat.r += cat.dr;
      cat.c += cat.dc;
      if(!inBounds(cat.r,cat.c) || !grid[cat.r][cat.c].owned){
        cat.dead = true;
      } else {
        // sometimes sit
        if(Math.random() < 0.25) cat.sitTimer = 1.5 + Math.random()*2.5;
        // maybe turn
        if(Math.random() < 0.4){
          const dirs=[[0,1],[0,-1],[1,0],[-1,0]];
          const d = dirs[ri(0,3)];
          cat.dr=d[0]; cat.dc=d[1];
        }
      }
    }
  }
  cats = cats.filter(c => !c.dead);

  document.getElementById('cashEl').textContent=Math.floor(cash).toLocaleString('en-US');
  document.getElementById('popEl').textContent=population;
  document.getElementById('eduEl').textContent=education;
  document.getElementById('incomeEl').textContent='+$'+Math.round(incomeRate)+'/s';
}
